# Frontend environment variables – copy to .env
VITE_API_BASE_URL=http://localhost:4000/api

# Dev server (vite) – optional overrides for `npm run dev`
FRONTEND_PORT=1000
FRONTEND_HOST=0.0.0.0
# Backend origin the dev server proxies /api to
VITE_PROXY_TARGET=http://localhost:4000

# Number of receipt payloads sent per API call when submitting Standard/Misc receipts
# (default: 50).  Keeping batches small prevents HTTP gateway timeouts when
# Oracle takes several seconds per SOAP call on large receipt batches.
VITE_RECEIPT_CHUNK_SIZE=50

# Number of AR invoice payloads sent per API call when submitting from AR Pipeline page
# (default: 50).  All chunks are submitted concurrently so a larger chunk size reduces
# round trips without blocking subsequent chunks.
VITE_INVOICE_CHUNK_SIZE=50
# Polling interval in ms when waiting for an invoice batch to complete (default: 1000).
VITE_POLL_INTERVAL_MS=1000
