# Backend environment variables – copy this file to .env

# SQLite database file path (relative to backend/prisma/schema.prisma location)
# Prisma resolves this to:  backend/prisma/crm.db  (created automatically)
DATABASE_URL=file:./crm.db

# JWT secret key (use a long random string in production)
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=24h

# SOAP debugging (default: false)
# Set to 'true' to enable detailed SOAP request/response logging
# WARNING: Logs will include full XML payloads - disable in production
SOAP_DEBUG=false

# Oracle Cloud credentials (used for both REST & SOAP APIs)
ORACLE_USERNAME=your-oracle-username
ORACLE_PASSWORD=your-oracle-password

#ORACLE_USERNAME=Oraintegration
#ORACLE_PASSWORD=R@123456

# Oracle SOAP endpoint for customer profile lookup (resolves CustomerAccountId from account number)
# Mirrors Java FusionCustomerProfileClient.getCustomerAccountId() via ReceivablesCustomerProfileService.getActiveCustomerProfile
# Used by vendReceiptController.js Strategies 3b & 4
ORACLE_CUSTOMER_PROFILE_SOAP_URL=https://ehxk-test.fa.em2.oraclecloud.com/fscmService/ReceivablesCustomerProfileService

# Oracle REST API endpoint for customer profile lookup
ORACLE_CUSTOMERS_API_URL=https://ehxk-test.fa.em2.oraclecloud.com/fscmRestApi/resources/11.13.18.05/customers

# Oracle SOAP endpoint for AR Invoice creation (createSimpleInvoice)
ORACLE_AR_INVOICE_SOAP_URL=https://ehxk-test.fa.em2.oraclecloud.com/fscmService/RecInvoiceService

# Oracle SOAP endpoint for standard receipts (createStandardReceipt)
# Uses the same StandardReceiptService as Apply Receipt
ORACLE_STANDARD_RECEIPT_SOAP_URL=https://ehxk-test.fa.em2.oraclecloud.com/fscmService/StandardReceiptService

# Oracle REST API endpoint for AR Invoice creation (used by arInvoiceController and arPipelineController)
ORACLE_AR_INVOICE_URL=https://ehxk-test.fa.em2.oraclecloud.com/fscmRestApi/resources/11.13.18.05/receivablesInvoices

# Oracle REST API endpoint for inventory staged transactions
ORACLE_INVENTORY_API_URL=https://ehxk-test.fa.em2.oraclecloud.com/fscmRestApi/resources/11.13.18.05/inventoryStagedTransactions

# Oracle REST API endpoint for standard receipts
ORACLE_STANDARD_RECEIPT_API_URL=https://ehxk-test.fa.em2.oraclecloud.com/fscmRestApi/resources/11.13.18.05/standardReceipts

# Oracle SOAP endpoint for miscellaneous receipts
ORACLE_SOAP_URL=https://ehxk-test.fa.em2.oraclecloud.com/fscmService/MiscellaneousReceiptService

# Oracle REST API endpoint for receivables invoices lookup (Apply Receipt)
ORACLE_RECEIVABLES_INVOICES_API_URL=https://ehxk-test.fa.em2.oraclecloud.com/fscmRestApi/resources/11.13.18.05/receivablesInvoices

# Oracle REST API endpoint for standard receipts lookup (Apply Receipt)
ORACLE_STANDARD_RECEIPTS_LOOKUP_API_URL=https://ehxk-test.fa.em2.oraclecloud.com/fscmRestApi/resources/11.13.18.05/standardReceipts

# Oracle SOAP endpoint for apply receipt
ORACLE_APPLY_RECEIPT_SOAP_URL=https://ehxk-test.fa.em2.oraclecloud.com/fscmService/StandardReceiptService

# Server port
PORT=4000

# Frontend origin (used for CORS)
FRONTEND_URL=http://localhost:3000
#FRONTEND_URL=http://192.168.30.58:3000

# Bulk upload performance settings
# Number of concurrent API requests for standard/misc receipt submission (default: 5)
# Higher values = faster processing but more load on Oracle
# Lower values = slower but safer for Oracle API rate limits
CONCURRENT_REQUESTS=5

# Concurrency for AR Invoice batch creation (Pass 1) (default: 5)
# Controls how many invoices are submitted to Oracle in parallel.
# Increase for faster processing; lower to 1 if Oracle throttles with 429 errors.
ORACLE_INVOICE_CONCURRENCY=5

# Maximum retry attempts for failed API calls (default: 3)
# Failed requests will be retried with exponential backoff
MAX_RETRIES=3

# SOAP request timeout in milliseconds (default: 300000 = 5 minutes).
# Mirrors Java InsertObjectFusion.java OkHttpClient.readTimeout(300, TimeUnit.SECONDS).
# Oracle AR receipt SOAP calls can take up to 5 minutes on large datasets.
# Increase this if you still see timeouts on slow networks.
ORACLE_SOAP_TIMEOUT=300000

# SOAP socket connect timeout in milliseconds (default: 30000 = 30 seconds).
# Mirrors Java InsertObjectFusion.java OkHttpClient.connectTimeout(30, TimeUnit.SECONDS).
# Controls how long to wait for the TCP connection to Oracle to be established.
ORACLE_SOAP_CONNECT_TIMEOUT=30000

# Timeout for Oracle AR Invoice REST calls in milliseconds (default: 300000 = 5 minutes).
# Invoice REST calls (createInvoiceBatch / createInvoice) can take longer than SOAP calls
# because Oracle processes each line server-side. Set higher than ORACLE_SOAP_TIMEOUT.
# Falls back to ORACLE_SOAP_TIMEOUT if not set.
ORACLE_AR_INVOICE_TIMEOUT=300000

# Maximum number of invoice lines per Oracle REST call for batchOracleService (default: 100).
# Used by batchOracleService.js for DB-level batch chunking.
ORACLE_INVOICE_LINE_CHUNK_SIZE=100

# Number of receipt payloads the frontend sends per API call when submitting
# Standard/Misc receipts from VendReceiptPage (default: 50, configured on frontend as
# VITE_RECEIPT_CHUNK_SIZE).  Each API call is processed independently, preventing
# HTTP gateway timeouts when Oracle SOAP takes several seconds per receipt.

# ─── Batch Processing Configuration ─────────────────────────────────────────
# Mirrors jdbc-config.properties + oracleDbClient.js settings from integration-Oracle.
# These settings control the batchOracleService.js DAO layer.

# JDBC-equivalent connection pool settings (jdbc.pool.*)
# Initial connections to pre-warm (jdbc.pool.initialSize)
ORACLE_POOL_INITIAL_SIZE=5
# Maximum concurrent connections (jdbc.pool.maxActive)
ORACLE_POOL_MAX_ACTIVE=20
# Maximum ms to wait for a connection (jdbc.pool.maxWait)
ORACLE_POOL_MAX_WAIT_MS=10000
# Seconds before a connection attempt times out (corresponds to jdbc connectTimeout)
ORACLE_CONNECT_TIMEOUT_S=60

# Retry settings for transient Oracle API failures (mirrors oracleDbClient.js createConnection)
ORACLE_MAX_RETRIES=3
ORACLE_RETRY_MIN_MS=500
ORACLE_RETRY_MAX_MS=10000

# ResultSet fetch size equivalent – rows fetched per DB round-trip / chunk
# Maps to JDBC ResultSet.setFetchSize() and PKG_BATCH_PROCESSOR.PROCESS_NEXT_CHUNK chunk size.
# Hard cap is always 100 (Oracle REST gateway HTTP 504 limit).
ORACLE_FETCH_SIZE=100

# Transaction settings (mirrors jdbc transaction.timeout + transaction.isolation)
# Timeout in seconds (transaction.timeout=300)
ORACLE_TRANSACTION_TIMEOUT_S=300
# Isolation level string (for logging/documentation only; Oracle defaults to READ_COMMITTED)
ORACLE_TRANSACTION_ISOLATION=READ_COMMITTED

