// Prisma schema for CRM Inventory & Misc Receipt application
// Uses SQLite for zero-install local deployment on Windows / macOS / Linux

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite – a single file database, no server required
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE: SQLite does not support native enums.
// The `role` field is stored as a plain String.
// Valid values: "ADMIN", "MANAGER", "USER"

// User model – stores authentication credentials and role information
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         String   @default("USER")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inventoryUploads   InventoryUpload[]
  miscReceiptUploads MiscReceiptUpload[]
  standardReceiptUploads StandardReceiptUpload[]
  applyReceiptUploads ApplyReceiptUpload[]
  arInvoiceUploads   ArInvoiceUpload[]
  arInvoiceData      ArInvoiceData[]
  activityLogs       ActivityLog[]
  vendReceiptBatches VendReceiptBatch[]
  arInvoiceBatches   ArInvoiceBatch[]
}

// Tracks each bulk inventory CSV upload and its processing results
model InventoryUpload {
  id               Int      @id @default(autoincrement())
  userId           Int
  user             User     @relation(fields: [userId], references: [id])
  filename         String
  organizationName String   @default("")
  totalRecords     Int      @default(0)
  successCount     Int      @default(0)
  failureCount     Int      @default(0)
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())

  failures  InventoryFailureRecord[]
  successes InventorySuccessRecord[]
}

// Stores individual rows that succeeded during an inventory upload
// NOTE: rawData is stored as a JSON string (SQLite has no native JSON type)
model InventorySuccessRecord {
  id        Int             @id @default(autoincrement())
  uploadId  Int
  upload    InventoryUpload @relation(fields: [uploadId], references: [id])
  rowNumber Int
  rawData   String
  responseBody String?
  responseStatus Int?
  createdAt DateTime        @default(now())
}

// Stores individual rows that failed during an inventory upload
// NOTE: rawData is stored as a JSON string (SQLite has no native JSON type)
model InventoryFailureRecord {
  id                  Int             @id @default(autoincrement())
  uploadId            Int
  upload              InventoryUpload @relation(fields: [uploadId], references: [id])
  rowNumber           Int
  rawData             String
  errorMessage        String
  responseBody        String?
  responseStatus      Int?
  oracleErrorCode     String?   // e.g. "INV_INVALID_ITEM" — Oracle ErrorCode field
  oracleProcessStatus String?   // e.g. "3" — Oracle ProcessStatus: 1=success, 3=error
  createdAt           DateTime        @default(now())
}

// Tracks each miscellaneous receipt CSV upload and its SOAP response
model MiscReceiptUpload {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  filename        String
  xmlPayload      String
  totalRecords    Int      @default(0)
  successCount    Int      @default(0)
  failureCount    Int      @default(0)
  responseStatus  String?
  responseMessage String?
  responseLog     String?
  createdAt       DateTime @default(now())

  failures MiscReceiptFailure[]
}

// Stores rows that failed during a misc receipt upload
// NOTE: rawData is stored as a JSON string (SQLite has no native JSON type)
model MiscReceiptFailure {
  id              Int               @id @default(autoincrement())
  uploadId        Int
  upload          MiscReceiptUpload @relation(fields: [uploadId], references: [id])
  rowNumber       Int
  rawData         String
  errorMessage    String
  requestPayload  String?           // Full SOAP XML request sent to Oracle
  responseBody    String?           // Full response body from Oracle
  responseStatus  Int?              // HTTP status code from Oracle
  createdAt       DateTime          @default(now())
}

// Tracks each standard receipt CSV upload and its REST responses
model StandardReceiptUpload {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  filename        String
  payloadJson     String
  totalRecords    Int      @default(0)
  successCount    Int      @default(0)
  failureCount    Int      @default(0)
  status          String   @default("PROCESSING")
  responseMessage String?
  responseLog     String?
  createdAt       DateTime @default(now())

  failures StandardReceiptFailure[]
}

// Stores rows that failed during a standard receipt upload
// NOTE: rawData is stored as a JSON string (SQLite has no native JSON type)
model StandardReceiptFailure {
  id              Int                   @id @default(autoincrement())
  uploadId        Int
  upload          StandardReceiptUpload @relation(fields: [uploadId], references: [id])
  rowNumber       Int
  rawData         String
  errorMessage    String
  requestPayload  String?               // Full JSON payload sent to Oracle
  responseBody    String?               // Full response body from Oracle
  responseStatus  Int?                  // HTTP status code from Oracle
  createdAt       DateTime              @default(now())
}

// Tracks each apply receipt CSV upload and its processing results
model ApplyReceiptUpload {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  filename        String
  totalRecords    Int      @default(0)
  totalReceipts   Int      @default(0)
  successCount    Int      @default(0)
  failureCount    Int      @default(0)
  status          String   @default("PROCESSING")
  responseMessage String?
  responseLog     String?
  createdAt       DateTime @default(now())

  failures ApplyReceiptFailure[]
}

// Stores rows that failed during an apply receipt upload
// NOTE: rawData is stored as a JSON string (SQLite has no native JSON type)
model ApplyReceiptFailure {
  id                 Int                @id @default(autoincrement())
  uploadId           Int
  upload             ApplyReceiptUpload @relation(fields: [uploadId], references: [id])
  rowNumber          Int
  invoiceNumber      String
  receiptNumber      String
  errorMessage       String
  errorStep          String             // "INVOICE_LOOKUP", "RECEIPT_LOOKUP", "APPLY_RECEIPT"
  requestPayload     String?            // REST query or SOAP XML
  responseBody       String?
  responseStatus     Int?
  customerTrxId      String?            // Captured even if apply fails
  receiptId          String?            // Captured even if apply fails
  createdAt          DateTime           @default(now())
}

// Tracks each AR Invoice creation and its Oracle REST API response
model ArInvoiceUpload {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  payloadJson     String   // The full JSON payload sent to Oracle
  responseStatus  String?  // SUCCESS, FAILED, PROCESSING
  responseMessage String?  // Summary message
  responseBody    String?  // Full Oracle API response
  httpStatus      Int?     // HTTP status code from Oracle
  createdAt       DateTime @default(now())
  batchId         Int?     // FK to ArInvoiceBatch (null for legacy records)
  batch           ArInvoiceBatch? @relation(fields: [batchId], references: [id])
}

// Tracks a batch of AR Invoice creations submitted together
model ArInvoiceBatch {
  id           Int              @id @default(autoincrement())
  userId       Int
  user         User             @relation(fields: [userId], references: [id])
  totalRecords Int              @default(0)
  successCount Int              @default(0)
  failureCount Int              @default(0)
  status       String           @default("PROCESSING") // PROCESSING, SUCCESS, FAILED, PARTIAL
  message      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  uploads      ArInvoiceUpload[]
}

// Audit log for all user actions within the system
model ActivityLog {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  actionType    String
  actionDetails String
  ipAddress     String?
  createdAt     DateTime @default(now())
}

// Fusion Sales Metadata - lookup table for mapping sales data to AR invoices
// Contains customer, business unit, and transaction source information
model FusionSalesMetadata {
  id                   Int     @id @default(autoincrement())
  rowId                Int     @unique
  billToName           String
  billToAccount        Int
  siteNumber           String
  businessUnit         String
  txnSource            String
  txnType              String
  rateIsCorporate      String
  recActivityNameBank  String
  subinventory         String
  integrationSource    String
  distributionAccId    String?
  recActivityNameCash  String
  region               String
  customerType         String
  costCenterCode       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([billToName, subinventory])
  @@index([customerType, subinventory])
}

// AR Invoice Data - stores individual AR invoice line items for bulk operations
// Can be populated via CSV upload or manual entry, then used to generate Oracle payloads
model ArInvoiceData {
  id                      Int      @id @default(autoincrement())

  // Header information
  customerName            String
  customerNumber          String
  siteNumber              String
  subinventory            String?
  businessUnit            String
  transactionSource       String
  transactionType         String
  transactionDate         String   // YYYY-MM-DD format
  accountingDate          String   // YYYY-MM-DD format
  paymentTerms            String
  invoiceCurrencyCode     String
  crossReference          String?
  comments                String?

  // Line item information
  lineNumber              Int
  itemNumber              String
  description             String
  quantity                Float
  unitSellingPrice        Float
  taxClassificationCode   String
  salesOrder              String?
  memoLine                String?

  // Metadata
  userId                  Int
  user                    User     @relation(fields: [userId], references: [id])
  uploadBatchId           String?  // Group multiple lines from same CSV upload
  status                  String   @default("PENDING") // PENDING, PROCESSED, FAILED
  processedAt             DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([customerName, subinventory])
  @@index([uploadBatchId])
  @@index([status])
}

// Fusion Invoice Header - stores header-level responses from Oracle AR Invoice API
// Corresponds to FUSION_INVOICE_HEADER table in Oracle ODOO_INTEGRATION schema
model FusionInvoiceHeader {
  id                  Int      @id @default(autoincrement())
  rowId               Int?     // ROW_ID from Oracle
  requestId           Int?     // REQUEST_ID from Oracle
  status              String?  // Status from Oracle (e.g., "Success", "Failed")
  message             String?  // MESSAGE from Oracle (error/success message)
  requestDate         DateTime? // REQUEST_DATE from Oracle
  billToCustName      String?  // BILL_TO_CUST_NAME
  billToLocation      String?  // BILL_TO_LOCATION
  billToAccNumber     Int?     // BILL_TO_ACC_NUMBER
  businessUnit        String?  // BUSINESS_UNIT
  paymentTermsName    String?  // PAYMENT_TERMS_NAME
  txnSource           String?  // TXN_SOURCE
  txnType             String?  // TXN_TYPE
  txnDate             DateTime? // TXN_DATE
  glDate              DateTime? // GL_DATE
  currencyCode        String?  // CURRENCY_CODE
  txnNumber           Int?     // TXN_NUMBER
  customerTxnId       Int?     // CUSTOMER_TXN_ID
  region              String?  // REGION
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relationship to line items
  lines               FusionInvoiceLine[]

  @@index([status])
  @@index([requestId])
  @@index([txnNumber])
}

// Fusion Invoice Line - stores line-level responses from Oracle AR Invoice API
// Corresponds to FUSION_INVOICE_LINE table in Oracle ODOO_INTEGRATION schema
model FusionInvoiceLine {
  id                  Int      @id @default(autoincrement())
  rowId               Int?     // ROW_ID from Oracle
  requestId           Int?     // REQUEST_ID from Oracle
  status              String?  // Status from Oracle (e.g., "Success", "Failed")
  message             String?  // MESSAGE from Oracle (error/success message)
  requestDate         DateTime? // REQUEST_DATE from Oracle
  invoiceNumber       String?  // INVOICE_NUMBER
  lineNumber          Int?     // LINE_NUMBER
  itemNumber          String?  // ITEM_NUMBER
  description         String?  // DESCRIPTION
  uom                 String?  // UOM (Unit of Measure)
  quantity            Float?   // QUANTITY
  unitSellingPrice    Float?   // UNIT_SELLING_PRICE
  currencyCode        String?  // CURRENCY_CODE
  taxCode             String?  // TAX_CODE
  version             Int?     // VERSION
  salesOrder          String?  // SALES_ORDER
  salesOrderLine      Int?     // SALES_ORDER_LINE
  region              String?  // REGION
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relationship to header
  headerId            Int?
  header              FusionInvoiceHeader? @relation(fields: [headerId], references: [id])

  @@index([status])
  @@index([requestId])
  @@index([invoiceNumber])
  @@index([salesOrder])
}

// ─── Vend Receipt Tables ─────────────────────────────────────────────────────

// Fusion Receipt Method - maps payment methods to bank charges and tax rates
// Seeded from FUSION_RECEIPT_METHOD_202606021342.csv
model FusionReceiptMethod {
  id                 Int      @id @default(autoincrement())
  rowId              Int?
  receiptMethodId    String   // Oracle Receipt Method ID (numeric string)
  receiptMethodName  String   // e.g. "Mada", "Visa", "Cash", "Cash rounding"
  receiptIsCash      Boolean  @default(false)
  receiptBankCharge  Float    @default(0)
  receiptMethodTax   Float    @default(0)
  region             String   // SA, KW, BH, AE, OM, SN
  createdAt          DateTime @default(now())

  @@index([receiptMethodName, region])
  @@index([region])
}

// VendHQ Register - maps Vend store registers to Oracle bank accounts
// Seeded from VENDHQ_REGISTERS_202606021344.csv
model VendhqRegister {
  id             Int      @id @default(autoincrement())
  registerId     String   @unique
  outletId       String?
  registerName   String   // e.g. "AZIZMALL" – matches subinventory
  cashAccount    String?  // Cash account name
  cashAccountId  String?  // Oracle Cash account ID
  bankAccount    String?  // Bank account description (used in misc receipt BankAccountNumber)
  bankAccountId  String?  // Oracle Bank account ID (used in standard receipt RemittanceBankAccountNumber)
  version        String?
  deletedAt      String?
  region         String?
  giftAccount       String?
  giftAccountId     String?
  customerAccountId String?  // Oracle CUST_ACCOUNT_ID – cached after first Oracle REST resolution
  createdAt         DateTime @default(now())

  @@index([registerName])
  @@index([region])
}

// Fusion Standard Receipt - stores Oracle Standard Receipt API responses
// Corresponds to FUSION_STANDARD_RECEIPT table; seeded from CSV + updated on new submissions
model FusionStandardReceipt {
  id                   Int       @id @default(autoincrement())
  rowId                Int?      // ROW_ID from Oracle
  requestId            Int?      // REQUEST_ID from Oracle
  status               String?   // e.g. "Success", "Failed"
  message              String?
  requestDate          DateTime?
  currencyCode         String?
  receiptDate          DateTime?
  glDate               DateTime?
  exchangeDate         DateTime?
  exchangeRateType     String?
  receiptMethodId      String?   // RECEIPT_METHOD_ID (Oracle ID)
  receiptNumber        String?   // e.g. "Mada-2912269"
  remittanceBankAccId  String?   // REMITTANCE_BACK_ACC_ID
  depositDate          DateTime?
  customerId           String?   // CUSTOMER_ID
  orgId                String?   // ORG_ID
  amount               Float?
  region               String?
  integMode            String?   // AUTOMATIC / MANUAL
  batchId              Int?      // links to VendReceiptBatch (null for seeded historical data)

  createdAt            DateTime  @default(now())

  @@index([receiptNumber])
  @@index([status])
  @@index([requestId])
  @@index([batchId])
}

// Fusion Misc Receipt - stores Oracle Misc Receipt SOAP responses
// Corresponds to FUSION_MISC_RECEIPT table; seeded from CSV + updated on new submissions
model FusionMiscReceipt {
  id                Int       @id @default(autoincrement())
  rowId             Int?
  requestId         Int?
  status            String?
  message           String?
  requestDate       DateTime?
  currencyCode      String?
  glDate            DateTime?
  exchangeDate      DateTime?
  exchangeRateType  String?
  receiptMethodName String?   // e.g. "Mada", "Visa"
  receiptNumber     String?   // e.g. "Mada-2912269-MISC"
  bankAccNumber     String?   // BANK_ACC_NUMBER (full description)
  recActivityName   String?   // e.g. "Bank Charge"
  amount            Float?
  receiptDate       DateTime?
  region            String?
  integMode         String?
  batchId           Int?

  createdAt         DateTime  @default(now())

  @@index([receiptNumber])
  @@index([status])
  @@index([requestId])
  @@index([batchId])
}

// Fusion Apply Receipt - stores Oracle Apply Receipt responses
// Corresponds to FUSION_APPLY_RECEIPT table; seeded from CSV + updated on new submissions
model FusionApplyReceipt {
  id              Int       @id @default(autoincrement())
  rowId           Int?
  requestId       Int?
  status          String?
  message         String?
  requestDate     DateTime?
  accountingDate  DateTime?
  applicationDate DateTime?
  txnNumber       String?
  receiptNumber   String?
  amountApplied   Float?
  currencyCode    String?
  region          String?
  integMode       String?
  txnSource       String?
  batchId         Int?

  createdAt       DateTime  @default(now())

  @@index([receiptNumber])
  @@index([txnNumber])
  @@index([status])
  @@index([requestId])
  @@index([batchId])
}

// ─── Batch Scheduling Tables ──────────────────────────────────────────────────
// Mirrors oracle-crm/src/scheduler.js sync_schedules + schedule_executions tables.
// Also mirrors oracle-db/init-scripts/02-create-schema.sql SALES_INTEGRATION_STATUS pattern.

// Stores configuration for recurring Oracle Fusion sync jobs.
// Mirrors oracle-crm/src/scheduler.js sync_schedules table schema.
model SyncSchedule {
  id                 Int      @id @default(autoincrement())
  scheduleId         String   @unique   // UUID
  name               String
  enabled            Boolean  @default(true)
  // AR_INVOICE_BATCH | STANDARD_RECEIPT | MISC_RECEIPT | APPLY_RECEIPT | FULL_PIPELINE
  scheduleType       String
  cronExpression     String
  region             String?
  // true = use lastSyncTimestamp as cursor; false = use manual dateFrom/dateTo
  incremental        Boolean  @default(true)
  dateFrom           String?
  dateTo             String?
  lookbackDays       Int      @default(1)
  retryEnabled       Boolean  @default(true)
  maxRetries         Int      @default(3)
  notifyOnFailure    Boolean  @default(true)
  notificationConfig String?  // JSON: email/webhook settings
  lastRunAt          DateTime?
  // Checkpoint – equivalent to JDBC ResultSet cursor position for incremental fetch.
  // Next run processes only records created after this timestamp.
  lastSyncTimestamp  String?
  lastRunStatus      String?  // RUNNING | SUCCESS | FAILED
  runCount           Int      @default(0)
  failureCount       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  executions         ScheduleExecution[]

  @@index([enabled])
  @@index([scheduleType])
  @@index([region])
}

// Tracks each execution of a scheduled batch job.
// Mirrors oracle-crm/src/scheduler.js schedule_executions table schema.
model ScheduleExecution {
  id            Int      @id @default(autoincrement())
  scheduleId    String
  schedule      SyncSchedule @relation(fields: [scheduleId], references: [scheduleId])
  executionId   String   @unique  // UUID
  status        String   @default("RUNNING")  // RUNNING | SUCCESS | FAILED
  errorMessage  String?
  recordsSynced Int      @default(0)
  recordsFailed Int      @default(0)
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  durationMs    Int?

  @@index([scheduleId])
  @@index([startedAt])
  @@index([status])
}

// Stores fine-grained batch checkpoints – one row per (scheduleId, batchType, key).
// Mirrors the SALES_INTEGRATION_STATUS table in integration-Oracle oracle-db schema.
// Enables resumable processing: if a batch is interrupted, it restarts from the last
// committed checkpoint rather than reprocessing the entire date range.
model BatchCheckpoint {
  id           Int      @id @default(autoincrement())
  scheduleId   String?  // optional link to a SyncSchedule
  batchType    String   // e.g. "AR_INVOICE_BATCH", "STANDARD_RECEIPT"
  checkpointKey String  // e.g. region, dateFrom, or a cursor identifier
  checkpointValue String // last successfully processed cursor value
  recordsProcessed Int  @default(0)
  lastUpdated  DateTime @default(now()) @updatedAt

  @@unique([scheduleId, batchType, checkpointKey])
  @@index([batchType, checkpointKey])
}

// VendReceiptBatch - tracks each Vend Receipt payload generation and submission
model VendReceiptBatch {
  id                 Int      @id @default(autoincrement())
  userId             Int
  user               User     @relation(fields: [userId], references: [id])
  filename           String   // payment lines file name
  region             String   @default("SA")
  totalStandard      Int      @default(0)
  totalMisc          Int      @default(0)
  successStandard    Int      @default(0)
  failureStandard    Int      @default(0)
  successMisc        Int      @default(0)
  failureMisc        Int      @default(0)
  status             String   @default("GENERATED") // GENERATED, SUBMITTING, DONE, PARTIAL, FAILED
  payloadsJson       String   // generated payloads (standard + misc) as JSON
  responseLog        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([userId])
}
